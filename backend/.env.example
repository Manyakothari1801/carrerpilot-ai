SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5433/careerpilot
DB_USERNAME=careerpilot
DB_PASSWORD=careerpilot_local
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P30D
PASSWORD_RESET_EXPIRATION=PT30M
EXPOSE_LOCAL_RESET_TOKEN=true
RESUME_STORAGE_PATH=./runtime/resumes
RESUME_MAX_FILE_SIZE_MB=5
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=UNAVAILABLE
EMBEDDING_MODEL=
AI_CONNECT_TIMEOUT=PT5S
AI_REQUEST_TIMEOUT=PT30S
AI_MAX_INPUT_CHARACTERS=30000

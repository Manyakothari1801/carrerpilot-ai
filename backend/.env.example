SPRING_PROFILES_ACTIVE=prod
PORT=8081
DB_URL=jdbc:postgresql://database-host:5432/careerpilot
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
FRONTEND_ORIGIN=https://app.example.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P30D
PASSWORD_RESET_EXPIRATION=PT30M
EXPOSE_LOCAL_RESET_TOKEN=false
RESUME_STORAGE_PATH=./runtime/resumes
RESUME_MAX_FILE_SIZE_MB=5
AI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=UNAVAILABLE
EMBEDDING_MODEL=
ASSESSMENT_DEFAULT_DURATION=PT20M
ASSESSMENT_MAX_QUESTIONS=50
ASSESSMENT_AI_GENERATION_ENABLED=false
ML_SERVICE_URL=http://private-ml-service:8000
ML_CONNECT_TIMEOUT=PT3S
ML_READ_TIMEOUT=PT10S
ML_TOP_N=3
AI_CONNECT_TIMEOUT=PT5S
AI_REQUEST_TIMEOUT=PT45S
AI_MAX_INPUT_CHARACTERS=30000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TIME_ZONE=Asia/Kolkata
MAIL_HEALTH_ENABLED=false
APP_FRONTEND_URL=https://app.example.com
EXAM_REMINDER_LEAD_TIME=PT1H
EXAM_REMINDER_CRON=0 */5 * * * *
